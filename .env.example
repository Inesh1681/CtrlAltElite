# Optional, SERVER-SIDE ONLY (no VITE_ prefix — never shipped to the browser).
# Used by the Vercel function api/explain.ts (and by `npm run dev` via a Vite middleware).
# Without it, FLOWSHIELD uses the deterministic fallback explanation engine.
ANTHROPIC_API_KEY=

# Operator access code for the sign-in screen (default: flowshield).
VITE_ACCESS_CODE=flowshield
# Set to false to hide the demo access-code hint on the login page.
VITE_SHOW_DEMO_HINT=true

# --- Google sign-in (optional). Firebase console → Project settings → Your apps → Web app config.
# When all four are set, the login page shows "Continue with Google"; the access code stays as fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Roles for Google accounts (comma-separated emails). Everyone else is an operator.
VITE_COMMANDER_EMAILS=
VITE_VIEWER_EMAILS=
